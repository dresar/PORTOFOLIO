NODE_ENV=development
VITE_API_URL=/api
VITE_BACKEND_URL=http://localhost:3000

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require

# Authentication
JWT_SECRET=your-secure-jwt-secret-key-min-32-chars

# GitHub Storage (Optional for uploads)
GITHUB_TOKEN=ghp_exampletokenplaceholder
GITHUB_REPO=your-org/your-repo
GITHUB_BRANCH=main

# 9Router AI Gateway (Bilingual Auto-translation & AI Assistant)
AI_API_KEY=sk-example-9router-api-key
AI_API_URL=https://9router.serverinka.cloud/v1/chat/completions
AI_MODEL=MY-COMBO
AI_GATEWAY_BASE_URL=https://9router.serverinka.cloud/v1
AI_GATEWAY_API_KEY=sk-example-9router-api-key
AI_GATEWAY_MODEL=MY-COMBO
