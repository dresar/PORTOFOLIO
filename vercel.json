{
  "functions": {
    "api/**/*.ts": {
      "excludeFiles": "{public/**,asset/**,scripts/**}"
    },
    "api/index.ts": {
      "excludeFiles": "{public/**,asset/**,scripts/**}"
    }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "routes": [
    { "handle": "filesystem" },
    {
      "src": "/api/(.*)",
      "dest": "/api"
    },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}